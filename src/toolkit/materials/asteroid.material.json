{
  "$schema": "../../../.schemas/material.schema.json",
  "id": "asteroid",
  "tslFile": "materials/asteroid.tsl.ts",
  "type": "STANDARDNODEMATERIAL",
  "params": { "color": "#6b6158", "roughness": 0.9, "metalness": 0.0 },
  "staticDefines": { "octaves": 4 },
  "nodes": {
    "colorNode": {
      "seed": 0,
      "noiseScale": 1.4,
      "colorA": "#5d554d",
      "colorB": "#8a7f72",
      "pitColor": "#2b2622",
      "pitScale": 2.2,
      "pitSize": 0.35,
      "pitStrength": 0.7,
      "speckleColor": "#c9c2b4",
      "speckleScale": 9.0,
      "speckleAmount": 0.25,
      "roughnessMin": 0.75,
      "roughnessMax": 0.95,
      "bumpStrength": 0.05
    }
  },
  "debugData": {
    "name": "Asteroid",
    "description": "Procedural object-space rock (no UVs): mottled colours, Worley pits, mineral speckles, bump. Every input is on colorNode, which also sets roughnessNode and normalNode; override `seed` per mesh for a different rock."
  }
