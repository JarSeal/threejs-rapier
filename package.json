{
  "name": "aekasha-js",
  "version": "0.0.2",
  "description": "High-performance WebGPU application powered by the Ækasha framework.",
  "repository": "https://github.com/JarSeal/threerapier.git",
  "author": "JarSeal",
  "app_metadata": {
    "version": "0.0.1",
    "codename": "Infant",
    "name": "Example App",
    "fullName": "Example App for Ækasha",
    "description": "Project template utilizing the Ækasha modular toolkit.",
    "url": ""
  },
  "engine_metadata": {
    "version": "0.0.2",
    "codename": "Genesis",
    "name": "Ækasha",
    "fullName": "Ækasha Framework",
    "description": "The 'fifth element' of web development: a modular, high-performance WebGPU framework built on Three.js and the Ækasha ECS.",
    "url": "",
    "repository": "https://github.com/JarSeal/threerapier.git",
    "author": "JarSeal"
  },
  "keywords": [
    "aekasha",
    "aekasha-js",
    "ecs",
    "webgpu",
    "three.js",
    "rapier",
    "physics",
    "high-performance",
    "game-engine"
  ],
  "main": "dist/index.html",
  "license": "MIT",
  "private": false,
  "type": "module",
  "scripts": {
    "gatherAppData": "node ./devTools/gatherAppData.js",
    "dev": "yarn gatherAppData && VITE_APP_ENV=development vite serve --port 8080 --host",
    "dev:test": "yarn gatherAppData && VITE_APP_ENV=test vite serve --port 8080 --host",
    "dev:production": "yarn gatherAppData && vite serve --port 8080 --host",
    "lint": "eslint",
    "build": "NODE_ENV=production yarn gatherAppData && tsc && vite build && yarn gatherAppData",
    "build:test": "NODE_ENV=production yarn gatherAppData && tsc && VITE_APP_ENV=test vite build && yarn gatherAppData",
    "docs": "typedoc",
    "codecat": "./devTools/codecat.sh",
    "cc": "bash ./devTools/codecat.sh",
    "codecatAsExecutable": "chmod +x ./devTools/codecat.sh"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "0.19.3",
    "stats-gl": "3.6.0",
    "three": "0.183.2",
    "tweakpane": "4.0.5"
  },
  "devDependencies": {
    "@tweakpane/core": "2.0.5",
    "@types/node": "22.10.6",
    "@types/three": "0.183.1",
    "@typescript-eslint/eslint-plugin": "7.8.0",
    "@typescript-eslint/parser": "7.8.0",
    "eslint": "9.2.0",
    "eslint-config-import": "0.13.0",
    "eslint-config-prettier": "9.1.0",
    "eslint-plugin-import": "2.29.1",
    "eslint-plugin-prettier": "5.1.3",
    "prettier": "3.2.5",
    "sass": "1.82.0",
    "typedoc": "0.28.14",
    "typescript": "5.4.5",
    "vite": "5.2.11",
    "vite-plugin-wasm": "3.4.1"
  },
  "engines": {
    "node": ">=22.1.0",
    "yarn": ">=1.22.15"
  }
}
