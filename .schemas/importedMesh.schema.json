          "type": "boolean"
        },
        "groupId": {
          "type": "string"
        },
        "groupName": {
          "type": "string"
        },
        "meshIndex": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "array",
              "items": {
                "type": "number"
              }
            }
          ]
        },
        "throwOnError": {
          "type": "boolean"
        },
        "saveMaterial": {
          "type": "boolean"
        }
      },
