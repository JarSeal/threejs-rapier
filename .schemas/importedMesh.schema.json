    "__sourcePath": {
      "type": "string"
    },
    "__saveData": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "fileName": {
              "type": "string"
            },
            "appId": {
              "type": "string"
            },
            "importGroup": {
              "type": "boolean"
            },
            "allMeshesVisible": {
              "type": "boolean"
            },
            "groupId": {
              "type": "string"
            },
            "groupName": {
              "type": "string"
            },
            "meshIndex": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "array",
                  "items": {
                    "type": "number"
                  }
                }
              ]
            },
            "throwOnError": {
              "type": "boolean"
            },
            "saveMaterial": {
              "type": "boolean"
            },
            "__meta": {
              "type": "object",
              "properties": {
                "date": {
                  "type": "number"
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      }
    }
  },
  "required": [
    "props"
  ],
  "additionalProperties": false
