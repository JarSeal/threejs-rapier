          "type": "string"
        },
        "disabled": {
          "type": "boolean"
        },
        "persistent": {
          "type": "boolean"
        },
        "doNotAddToScene": {
          "type": "boolean"
        },
        "userData": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {}
        },
        "debugData": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "description": {
              "type": "string"
            },
            "comments": {
              "type": "array",
