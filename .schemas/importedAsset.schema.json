          "type": "object",
          "properties": {
            "__meta": {
              "type": "object",
              "properties": {
                "date": {
                  "type": "number"
                },
                "engineVersion": {
                  "type": "string",
                  "pattern": "^\\d+\\.\\d+\\.\\d+$"
                },
                "toolkitVersion": {
                  "type": "string",
                  "pattern": "^\\d+\\.\\d+\\.\\d+$"
                },
                "appVersion": {
                  "type": "string",
                  "pattern": "^\\d+\\.\\d+\\.\\d+$"
                }
              },
              "additionalProperties": false
            },
            "id": {
              "type": "string"
            },
            "fileName": {
              "type": "string",
              "description": "Relative to this JSON file (\"./source/rock.png\", optimized into src/public/aek-assets/), or a URL path served from src/public (\"/textures/rock.png\", optionally after `path`)."
            },
            "importTextures": {
              "anyOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "object",
                  "properties": {
                    "texOpts": {
                      "type": "object",
                      "properties": {
                        "image": {},
                        "mapping": {
                          "type": "number"
                        },
                        "wrapS": {
                          "type": "number"
                        },
                        "wrapT": {
                          "type": "number"
                        },
                        "magFilter": {
                          "type": "number"
                        },
                        "minFilter": {
                          "type": "number"
                        },
                        "type": {
                          "type": "number"
                        },
                        "anisotropy": {
                          "type": "number"
                        },
                        "colorSpace": {
                          "anyOf": [
                            {
                              "type": "string",
                              "const": ""
                            },
                            {
                              "type": "string",
                              "const": "srgb"
                            },
                            {
                              "type": "string",
                              "const": "srgb-linear"
                            }
                          ]
                        }
                      },
                      "additionalProperties": false
                    },
                    "isPersistent": {
                      "type": "boolean"
                    }
                  },
                  "additionalProperties": false
                }
              ]
            },
            "meshIndex": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "array",
                  "items": {
                    "type": "number"
                  }
                }
              ]
            },
            "isPersistent": {
              "type": "boolean"
            },
            "lodChain": {
              "anyOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "object",
                  "properties": {
                    "ratios": {
                      "description": "Target triangle counts, as ratios of the base's, one per level. Default [0.5, 0.25, 0.1].",
                      "type": "array",
                      "items": {
                        "type": "number",
                        "exclusiveMinimum": 0,
                        "exclusiveMaximum": 1
                      }
                    },
                    "maxError": {
                      "description": "meshoptimizer's target error cap, relative to the mesh's extent (its largest bounding box side). Default 0.05.",
                      "type": "number",
                      "exclusiveMinimum": 0,
                      "maximum": 1
                    },
                    "attributeWeights": {
                      "description": "How much normal and uv deviation count against a collapse. Default 0.5 each (0 ignores it).",
                      "type": "object",
                      "properties": {
                        "normal": {
                          "type": "number",
                          "minimum": 0
                        },
                        "uv": {
                          "type": "number",
                          "minimum": 0
                        }
                      },
                      "additionalProperties": false
                    },
                    "compactVertices": {
                      "description": "Each level gets its own trimmed vertex arrays instead of sharing the base's. Better for large meshes whose far levels use few vertices. Default false.",
                      "type": "boolean"
                    },
                    "lockBorder": {
                      "description": "Keeps the mesh's open borders in place, so tiling geometry still meets its neighbours. Default false.",
                      "type": "boolean"
                    },
                    "permissive": {
                      "description": "Lets collapses cross attribute seams. Flat-shaded geometry (a normal per face) doesn't simplify without it. Default false.",
                      "type": "boolean"
                    }
                  },
                  "additionalProperties": false,
                  "description": "generateLodChain options."
                }
              ],
              "description": "Generate a LOD chain (p347) for every rendered geometry of the import after it loads: true for the default options, or the options. Nothing selects a level until p348's `lod` on a mesh. Skinned and morph-target geometry is skipped."
            },
            "throwOnError": {
              "type": "boolean"
            },
            "debugData": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "description": {
                  "type": "string"
                },
                "comments": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "timestamp": {
                        "type": "number"
                      },
                      "comment": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "timestamp",
                      "comment"
                    ],
                    "additionalProperties": false
                  }
                },
                "todo": {
                  "type": "object",
                  "propertyNames": {
                    "type": "string"
                  },
                  "additionalProperties": {}
                },
                "debugObj": {
                  "type": "object",
                  "propertyNames": {
                    "type": "string"
                  },
                  "additionalProperties": {}
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      }
    }
  },
  "required": [
    "fileName"
  ],
  "additionalProperties": false
}