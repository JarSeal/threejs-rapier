{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "id": {
      "type": "string"
    },
    "size": {
      "type": "array",
      "items": [
        {
          "type": "integer",
          "minimum": 4,
          "maximum": 9007199254740991,
          "multipleOf": 4
        },
        {
          "type": "integer",
          "minimum": 4,
          "maximum": 9007199254740991,
          "multipleOf": 4
        }
      ],
      "description": "The layout's width and height in px (multiples of 4). A slot over its maxSize drops its top mip levels."
    },
    "padding": {
      "description": "Px of edge extension around each cell's content (default 8). The mip chain stops at the level it protects: 2^level ≤ padding, so 16 keeps levels 0-4. Packed cells go on a grid of 4 · 2^⌊log2 padding⌋ px (64 for 16), so the last level's 4 × 4 compression blocks never hold two cells; an explicit rect off that grid shortens the chain.",
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "mipChain": {
      "description": "PROTECTED (default): the mip chain stops at the last level the padding and the rects keep apart, so a cell never reads its neighbour. FULL: every level down to 1 × 1 (the exact 2 × 2 box, area-filtered past an odd size), so the cells mix below the protected levels: for cells whose neighbours are near-identical (an impostor's neighbouring views), where a short chain would shimmer at distance.",
      "type": "string",
      "enum": [
        "PROTECTED",
        "FULL"
      ]
    },
    "slots": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z\\d_-]*$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "texOpts": {
            "type": "object",
            "properties": {
              "mapping": {
                "type": "number"
              },
              "wrapS": {
                "type": "number"
              },
              "wrapT": {
                "type": "number"
              },
              "magFilter": {
                "type": "number"
              },
              "minFilter": {
                "type": "number"
              },
              "type": {
                "type": "number"
              },
              "anisotropy": {
                "type": "number"
              },
              "colorSpace": {
                "anyOf": [
                  {
                    "type": "string",
                    "const": ""
                  },
                  {
                    "type": "string",
                    "const": "srgb"
                  },
                  {
                    "type": "string",
                    "const": "srgb-linear"
                  }
                ]
              }
            },
            "additionalProperties": false
          },
          "image": {
            "description": "A ready-made image of the whole layout (the atlas's `size`), relative to this JSON (\"./bake.png\") or served from src/public, or a texture asset's id: the slot isn't composed from its cells (no resize, edge extension or fill), so it holds them where their `rect`s say (every cell needs one) and no cell has a source in it. For an atlas a tool already composed, eg. an exported impostor's.",
            "type": "string",
            "minLength": 1
          },
          "fill": {
            "description": "RGB(A), linear 0..1 like a pack constant: the atlas outside the cells, and the cells without a source in this slot (default transparent black; a normal map wants [0.5, 0.5, 1]). Not with `image`.",
            "anyOf": [
              {
                "type": "array",
                "items": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "number"
                  },
                  {
                    "type": "number"
                  }
                ]
              },
              {
                "type": "array",
                "items": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "number"
                  },
                  {
                    "type": "number"
                  },
                  {
                    "type": "number"
                  }
                ]
              }
            ]
          },
          "optimize": {
            "type": "object",
            "properties": {
              "profile": {
                "description": "A profile of assets.config.json.",
                "type": "string"
              },
              "slot": {
                "description": "A standalone texture's slot (default: default). A GLB's textures are classified by their material slot.",
                "type": "string",
                "enum": [
                  "default",
                  "baseColor",
                  "normal",
                  "metallicRoughness",
                  "occlusion",
                  "emissive",
                  "orm",
                  "data"
                ]
              },
              "textures": {
                "description": "Per-slot overrides.",
                "type": "object",
                "properties": {
                  "default": {
                    "type": "object",
                    "properties": {
                      "codec": {
                        "type": "string",
                        "enum": [
                          "uastc",
                          "etc1s",
                          "none"
                        ],
                        "description": "uastc: 1 B/px on every device (BC7 / ASTC 4×4), the default. etc1s: smallest download, colour slots only. none: not encoded (exact data, CPU readback)."
                      },
                      "maxSize": {
                        "description": "Largest side in px, downscaled to fit (null: the source size).",
                        "anyOf": [
                          {
                            "type": "integer",
                            "minimum": 4,
                            "maximum": 9007199254740991
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "mipmaps": {
                        "description": "Write the full mip chain (default true).",
                        "type": "boolean"
                      },
                      "level": {
                        "description": "UASTC only: --uastc-quality, 0 (fastest) to 4 (slowest).",
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 4
                      },
                      "rdo": {
                        "description": "UASTC only: RDO lambda (0: off). 2 for colour, 1 for normal / ORM / data.",
                        "type": "number",
                        "minimum": 0
                      },
                      "zstd": {
                        "description": "UASTC only: Zstandard supercompression level (0: off).",
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 22
                      },
                      "quality": {
                        "description": "ETC1S only: --qlevel, 1 to 255.",
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 255
                      },
                      "normalMode": {
                        "description": "Two-channel normal map (X in RGB, Y in A). Needs a material that unpacks it.",
                        "type": "boolean"
                      }
                    },
                    "additionalProperties": false
                  },
                  "baseColor": {
