            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "type": "string",
              "minLength": 1,
              "description": "A texture asset's id (its source file or pack, not its output), or a source image relative to this JSON (\"./source/crack.png\") or served from src/public (\"/textures/crack.png\")."
            }
          },
          "data": {
            "description": "Free-form, passed through to the cell table (eg. a decal's physical size).",
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          }
        },
