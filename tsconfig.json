{
  "compilerOptions": {
    "allowJs": false,
    "forceConsistentCasingInFileNames": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "strict": true,
    "skipLibCheck": true,
    "target": "ES2021",
    "useDefineForClassFields": true,
    "lib": ["ES2021", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "esModuleInterop": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "typeRoots": ["./src/types", "./node_modules/@types"],
    // Only these @types are global; the rest come in through imports. Without the list, every
    // folder in the typeRoots is, and with typeRoots set explicitly, tsc fails on one that has
    // no typings: the deprecated stub @types/wrap-ansi@8.1.0, which yarn 1 installs for
    // @gltf-transform/cli (docs/issues/gltf-transform-cli-types-wrap-ansi-stub.md).
    "types": ["node"]
  },
  "typedocOptions": {
    "entryPoints": ["src/_engine/**/*.ts", "src/toolkit/**/*.ts"],
    "exclude": ["**/_dbg__*", "**/generatedApp*", "**/*.test.ts"],
    "out": "docs-api",
    "theme": "default",
    "excludePrivate": true,
    "readme": "none"
  },
  "exclude": ["node_modules"],
  "include": ["src/**/*", "devTools/**/*.ts", "vite.config.ts", "vitest.config.ts", "vite-env.d.ts"]
}
